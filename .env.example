# Copia este fichero como ".env" en desarrollo local y rellena los valores
# reales (nunca subas el ".env" real a git). En Render, cada una de estas
# claves se configura como variable de entorno del servicio "oposicion-age"
# (ver render.yaml) desde el panel de control, no desde este fichero.

# --- Firebase (autenticación + Firestore) ---
# Credenciales de la cuenta de servicio de Firebase, en formato JSON, en UNA
# SOLA línea. Se usa esta variable en vez de un fichero porque no todas las
# plataformas (p. ej. Render) permiten subir ficheros de secretos.
FIREBASE_CREDENTIALS_JSON=
# Alternativa a FIREBASE_CREDENTIALS_JSON: ruta a un fichero de credenciales
# en disco (útil en local, o en plataformas con "Secret Files"). Si se
# define FIREBASE_CREDENTIALS_JSON, esta variable se ignora.
FIREBASE_KEY_PATH=clave-firebase.json

# --- IA ---
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# Modelo de DeepSeek para Tu Tutor (opcional). Por defecto "deepseek-chat"
# (el mismo que usa el resto de la app: tests, resúmenes, esquemas...). Para
# probar el modelo de razonamiento de DeepSeek (más lento y caro, pero más
# capaz en preguntas de varios pasos), poner aquí "deepseek-reasoner" -- basta
# con quitar la variable (o volver a "deepseek-chat") para revertir.
TUTOR_MODELO_IA=deepseek-chat

# --- Stripe (pagos y suscripciones) ---
STRIPE_SECRET_KEY=
# Firma del webhook de Stripe (Dashboard de Stripe -> Webhooks -> tu endpoint).
STRIPE_WEBHOOK_SECRET=
# IDs de los "Price" de Stripe para cada plan de pago.
STRIPE_PRICE_ID_BASICO=
STRIPE_PRICE_ID_PREMIUM=

# --- Correo (Brevo) ---
BREVO_API_KEY=
# Remitente: tiene que ser un dominio o correo YA VERIFICADO en tu cuenta de
# Brevo (Senders, Domains & Dedicated IPs -> Senders/Domains), si no Brevo
# rechaza el envío. Un correo suelto (como este Gmail) se verifica con un
# solo clic (Brevo te manda un email de confirmación a esa bandeja), pero
# tiene peor entregabilidad que un dominio propio verificado por DNS
# (SPF/DKIM) -- si tienes acceso al DNS de dominatuopo.com, verificar el
# dominio y usar algo como no-reply@dominatuopo.com da mejores resultados a
# la larga (menos riesgo de caer en spam).
BREVO_FROM_EMAIL=dominatuopo@gmail.com
BREVO_FROM_NOMBRE=Domina tu Opo
# IDs (numéricos) de las plantillas transaccionales de Brevo (Campañas ->
# Plantillas -> Transaccional). Si se dejan vacíos, ese correo se manda con
# el HTML de reserva incluido en email_utils.py en vez de con la plantilla.
BREVO_TEMPLATE_BIENVENIDA=
BREVO_TEMPLATE_RESET_PASSWORD=
BREVO_TEMPLATE_VERIFICACION=
BREVO_TEMPLATE_CANCELACION=
BREVO_TEMPLATE_REACTIVACION=
BREVO_TEMPLATE_PAGO_FALLIDO=
BREVO_TEMPLATE_RACHA_RIESGO=
BREVO_TEMPLATE_REENGAGEMENT=
BREVO_TEMPLATE_PRUEBA_TERMINANDO=
BREVO_TEMPLATE_PRUEBA_TERMINADA=
BREVO_TEMPLATE_AVISO_OFICIAL=

# --- Publicación automática de avisos oficiales en las páginas públicas ---
# Token de GitHub (fine-grained, permiso "Contents: Read and write" solo en
# este repo) que usa publicacion_estatica_boe.py para commitear la sección
# de avisos oficiales de cada página /oposicion-* al aprobar un aviso desde
# el panel de admin. Si se deja vacío, esa página no se actualiza sola (se
# registra un aviso en el log) pero el resto sigue funcionando igual
# (Firestore + email a los usuarios).
GITHUB_TOKEN=

# --- Notificaciones push del navegador (opcional) ---
# Si se dejan vacías, las notificaciones quedan desactivadas sin más (el
# botón de "avisarme" no aparece). Para activarlas: ejecuta una vez
# `python generar_claves_vapid.py` y pega aquí lo que imprime.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:soporte@oposicion-age.com

# --- Monitorización de errores (opcional) ---
# Si se deja vacía, Sentry queda desactivado sin más (los errores solo van a
# los logs). Para activarla: crea una cuenta gratuita en sentry.io, un
# proyecto Flask/Python, y pega aquí el DSN que te da.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Backend Flask ---
# Clave interna para llamadas administrativas/protegidas (no la comparte
# nunca el frontend público).
API_SECRET_KEY=
# Clave para el cron externo (GitHub Actions) que dispara el recordatorio
# diario de racha en /tareas/recordatorios-racha. Independiente de
# API_SECRET_KEY porque quien llama no es el frontend ni una persona
# autenticada, sino un workflow programado.
CRON_SECRET_KEY=
# Opcional: quién recibe el aviso por email si el gasto diario en IA se
# dispara respecto a la media reciente (/tareas/vigilar-gasto-ia). Si se
# deja vacía, cae en BREVO_FROM_EMAIL.
ADMIN_ALERT_EMAIL=
# Opcional: URL de un proxy de salida con IP estática (Fixie o QuotaGuard),
# solo necesaria si el hosting usado (Render en plan gratuito, por
# ejemplo) tiene la IP de salida compartida bloqueada por Google -- ver
# firebase_setup.py:propagar_proxy_saliente(). Rellena SOLO la que uses --
# si están las dos, gana FIXIE_URL. Sin ninguna, no cambia nada del
# comportamiento actual.
FIXIE_URL=
QUOTAGUARDSTATIC_URL=
# Orígenes permitidos por CORS, separados por comas. En local suele bastar
# con el puerto donde sirvas el frontend estático.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# URL pública del frontend (se usa para construir los enlaces de vuelta tras
# el checkout de Stripe y el portal de facturación).
FRONTEND_URL=http://localhost:8080
# Puerto en el que arranca Flask. La mayoría de plataformas (Render
# incluida) la inyectan solas -- normalmente no hace falta tocarla.
PORT=5000
