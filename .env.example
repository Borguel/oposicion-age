# Copia este fichero como ".env" en desarrollo local y rellena los valores
# reales (nunca subas el ".env" real a git). En Render, cada una de estas
# claves se configura como variable de entorno del servicio "oposicion-age"
# (ver render.yaml) desde el panel de control, no desde este fichero.

# --- Firebase (autenticación + Firestore) ---
# Credenciales de la cuenta de servicio de Firebase, en formato JSON, en UNA
# SOLA línea. Se usa esta variable en vez de un fichero porque no todas las
# plataformas (p. ej. Render) permiten subir ficheros de secretos.
FIREBASE_CREDENTIALS_JSON=
# Alternativa a FIREBASE_CREDENTIALS_JSON: ruta a un fichero de credenciales
# en disco (útil en local, o en plataformas con "Secret Files"). Si se
# define FIREBASE_CREDENTIALS_JSON, esta variable se ignora.
FIREBASE_KEY_PATH=clave-firebase.json

# --- IA ---
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# --- Stripe (pagos y suscripciones) ---
STRIPE_SECRET_KEY=
# Firma del webhook de Stripe (Dashboard de Stripe -> Webhooks -> tu endpoint).
STRIPE_WEBHOOK_SECRET=
# IDs de los "Price" de Stripe para cada plan de pago.
STRIPE_PRICE_ID_BASICO=
STRIPE_PRICE_ID_PREMIUM=

# --- Correo (SendGrid) ---
SENDGRID_API_KEY=
# Remitente verificado en SendGrid para los correos que manda la web
# (bienvenida, recuperación de contraseña, etc.).
SENDGRID_FROM_EMAIL=no-reply@oposicion-age.com
# IDs de los Dynamic Templates de SendGrid (Email API -> Dynamic Templates).
# Si se dejan vacíos, ese correo se manda con el HTML de reserva incluido
# en email_utils.py en vez de con la plantilla de SendGrid.
SENDGRID_TEMPLATE_BIENVENIDA=
SENDGRID_TEMPLATE_RACHA_RIESGO=
SENDGRID_TEMPLATE_REENGAGEMENT=

# --- Notificaciones push del navegador (opcional) ---
# Si se dejan vacías, las notificaciones quedan desactivadas sin más (el
# botón de "avisarme" no aparece). Para activarlas: genera un par de claves
# VAPID con `vapid --gen` (paquete py-vapid, ya en requirements.txt) y pega
# aquí la pública y la privada.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:soporte@oposicion-age.com

# --- Monitorización de errores (opcional) ---
# Si se deja vacía, Sentry queda desactivado sin más (los errores solo van a
# los logs). Para activarla: crea una cuenta gratuita en sentry.io, un
# proyecto Flask/Python, y pega aquí el DSN que te da.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Backend Flask ---
# Clave interna para llamadas administrativas/protegidas (no la comparte
# nunca el frontend público).
API_SECRET_KEY=
# Clave para el cron externo (GitHub Actions) que dispara el recordatorio
# diario de racha en /tareas/recordatorios-racha. Independiente de
# API_SECRET_KEY porque quien llama no es el frontend ni una persona
# autenticada, sino un workflow programado.
CRON_SECRET_KEY=
# Orígenes permitidos por CORS, separados por comas. En local suele bastar
# con el puerto donde sirvas el frontend estático.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# URL pública del frontend (se usa para construir los enlaces de vuelta tras
# el checkout de Stripe y el portal de facturación).
FRONTEND_URL=http://localhost:8080
# Puerto en el que arranca Flask. La mayoría de plataformas (Render
# incluida) la inyectan solas -- normalmente no hace falta tocarla.
PORT=5000
